# Flowsink Activity Engine — environment configuration
# Copy to .env and fill in values for your machine.

# Device identification
# DEVICE_ID=auto          # auto = use COMPUTERNAME (Windows) or HOSTNAME

# Logging
# LOG_LEVEL=INFO

# Server (optional — only needed when running the FastAPI backend)
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8000

# Frontend API keys — NEVER commit real keys.  Use a local .env.local file
# (already git-ignored) when running the static dashboard:
# GEMINI_API_KEY=
# VITE_GEMINI_API_KEY=