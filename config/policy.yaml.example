# Flowsink Activity Engine — Policy Document
# Copy this file to policy.yaml and adjust the rules as needed.
#
# Canonical schema (validated by PolicyDocument / core.policies):
#   version    -> str
#   focus      -> FocusPolicy  (allowed/blocked domains & apps, url patterns, escalation)
#   escalation -> EscalationPolicy (three-level escalation delays & threshold)
#   bedtime    -> BedtimePolicy (schedule + staged warnings)
#
# See docs/POLICY_ENGINE.md for full syntax. Any unknown top-level key is
# ignored on load, so prefer the keys below to avoid silently empty rules.

version: "1"

focus:
  enabled: true
  # Domains always allowed even during focus time.
  allowed_domains:
    - classroom.google.com
    - docs.google.com
    - wikipedia.org
    - "*.google.com"
  # Domains blocked while focus is active.
  blocked_domains:
    - facebook.com
    - tiktok.com
    - youtube.com
    - instagram.com
    - discord.com
    - twitch.tv
    - netflix.com
  # Desktop apps always allowed.
  allowed_apps:
    - Chrome
    - "Microsoft Edge"
    - Firefox
    - Code
    - "Visual Studio Code"
    - word
    - excel
    - powerpoint
  # Apps blocked during focus time.
  blocked_apps:
    - Discord
    - Steam
    - Spotify
    - Valorant
    - "League of Legends"
    - Roblox
    - Minecraft
  # Extra URL patterns allowed (regex-ish globs).
  allowed_url_patterns: []
  # Seconds to wait before escalating a focus violation.
  escalation_delay_seconds: 10
  # Consecutive violations before an action is taken.
  violation_threshold: 3

escalation:
  level_1_delay_seconds: 10
  level_2_delay_seconds: 30
  level_3_violation_threshold: 3

bedtime:
  enabled: false
  start_time: "22:30"
  level_1_warning_minutes: 15
  level_2_warning_minutes: 5
  level_3_action: restricted_mode  # restricted_mode | shutdown | lock</arg_value>
