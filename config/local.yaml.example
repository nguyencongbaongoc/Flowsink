# Flowsink Activity Engine — Local Configuration (optional override)
# Copy this file to config/local.yaml and adjust as needed.
#
# Canonical schema = activity_engine.config.models.Config:
#   device     -> id
#   runtime    -> mode  (dry_run | audit_only | enforce)
#   monitoring -> process/browser/network toggles
#   logging    -> level (TRACE/DEBUG/INFO/WARNING/ERROR/CRITICAL), structured
#
# NOTE: config/local.yaml is optional. If absent the engine uses bundled
#      defaults from Config(). The server host/port used by the FastAPI
#      backend are configured in run_windows.bat / uvicorn invocation,
#      not here.

# Device identification
device:
  id: "auto"   # "auto" resolves to the machine hostname (COMPUTERNAME/HOSTNAME)

# Runtime behavior
runtime:
  mode: "dry_run"  # dry_run | audit_only | enforce

# Which monitors to enable
monitoring:
  process: true
  browser: true
  network: true

# Logging
logging:
  level: "INFO"   # TRACE | DEBUG | INFO | WARNING | ERROR | CRITICAL
  structured: true