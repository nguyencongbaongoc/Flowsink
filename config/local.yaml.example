# Local Configuration for Activity Engine
# Copy this file to local.yaml and adjust values as needed

# Device Identification
device:
  id: "device-001"
  name: "Student Laptop"

# Runtime Configuration
runtime:
  mode: "enforcement"  # Options: "enforcement", "dry_run", "off"
  
# Logging Configuration
logging:
  level: "INFO"  # Options: DEBUG, INFO, WARNING, ERROR
  format: "json"  # Options: json, text
  
# Monitoring Settings
monitoring:
  poll_interval_seconds: 5
  screenshot_enabled: true
  screenshot_interval_seconds: 60
  
# Policy Configuration
policy:
  default_policy: "policy/default_policies.yaml"
  custom_policy: null  # Path to custom policy if any
  
# Server Configuration (if running server)
server:
  host: "127.0.0.1"
  port: 8000
  cors_origins: ["*"]