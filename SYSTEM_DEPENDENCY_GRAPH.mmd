    class E1,E2,E3,E4,E5,E6,E7 active;
    class FACADE,EVENT,POLICY,EVAL,CLASS,ACTION,ESCAL,STATE,REPO,SHOT,CONF,PLOA,SCREEN,WINSCREEN,MOCKSCREEN,MOCKEXEC active;
    class BSTATE,BEVENTS,TDTO,TPROTO,TSER,UIDS active;
    class MOCKPROC,MOCKBROW,MOCKNET,EXTBROW,WINPROC,WINNET,WINDEV active;
    class ACTIVITY,BEDTIME,FOCUS orphan;
    class UTILLOG legacy;
    class WINBROW orphan;
    class WINACTION orphan;
    class INDEX,VITE,PKG,ASSETS orphan;
    class POLICYFILE,LOCALYAML,ENTRY broken;