graph TD
    classDef active fill:#d4edda,stroke:#28a745,stroke-width:2px;
    classDef legacy fill:#ffeeba,stroke:#ffc107,stroke-width:2px;
    classDef orphan fill:#f8d7da,stroke:#dc3545,stroke-width:2px;
    classDef broken fill:#f5c6cb,stroke:#c82333,stroke-width:2px;
    classDef demo fill:#e2e3e5,stroke:#6c757d,stroke-width:1px;

    subgraph ENTRYPOINTS
        E1["__main__.py"]
        E2["cli/__main__.py"]
        E3["console script activity-engine"]
        E4["run_windows.bat"]
        E5["uvicorn server:app"]
        E6["browser-extension/background.js"]
        E7["examples/simulate.py"]
    end

    subgraph CORE
        FACADE["engine/facade.py<br/>ActivityEngine"]
        EVENT["engine/event_engine.py"]
        POLICY["engine/policy_engine.py"]
