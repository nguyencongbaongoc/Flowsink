    subgraph ADAPTERS_LIVE
        MOCKPROC["adapters/mock/process_monitor.py"]
        MOCKBROW["adapters/mock/browser_monitor.py"]
        MOCKNET["adapters/mock/network_monitor.py"]
        EXTBROW["adapters/extension/browser_monitor.py"]
        WINPROC["adapters/windows/process_monitor.py"]
        WINNET["adapters/windows/network_monitor.py"]
        WINDEV["adapters/windows/device_controller.py"]
    end

    subgraph ORPHANS
        ACTIVITY["services/activity_service.py"]
        BEDTIME["services/bedtime_service.py"]
        FOCUS["services/focus_service.py"]
        UTILLOG["utils/logging.py"]
        WINBROW["adapters/windows/browser_monitor.py"]
        WINACTION["adapters/windows/action_executor.py"]
    end

    subgraph PHANTOM_FRONTEND
        INDEX["index.html"]
        VITE["vite.config.js"]
        PKG["package.json"]
        ASSETS["src/assets/* (hero.png, react.svg, vite.svg)"]
    end

    subgraph MISSING
        POLICYFILE{{"config/policy.yaml (MISSING)"}}
        LOCALYAML{{"config/local.yaml (MISSING)"}}
        ENTRY{{"React src/main.* (MISSING)"}}
    end

    E1 --> E2
    E2 --> FACADE
    E3 --> FACADE
    E4 --> E2
    E5 --> FACADE
    E5 --> SERVER_RESOURCES
    E6 --> E5
    E7 --> FACADE

    FACADE --> CONF
    FACADE --> PLOA
    FACADE --> EVENT
    FACADE --> POLICY
    FACADE --> STATE
    FACADE --> ACTION
    FACADE --> ESCAL
    FACADE --> REPO
    FACADE --> SHOT
    FACADE --> UIDS

    POLICY --> EVAL
    EVAL --> CLASS
    SHOT --> SCREEN
    SCREEN --> WINSCREEN
    SCREEN --> MOCKSCREEN
    ACTION --> MOCKEXEC

    BSTATE --> BEVENTS
    E5 --> BSTATE
    E5 --> TDTO
    E5 --> TPROTO
    E5 --> TSER

    E2 --> MOCKPROC
    E2 --> MOCKBROW
