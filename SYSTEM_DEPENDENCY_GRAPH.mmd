        CLASS["policy/classifier.py"]
        ACTION["engine/action_engine.py"]
        ESCAL["engine/escalation_engine.py"]
        STATE["engine/state_engine.py"]
        REPO["persistence/repository.py"]
        SHOT["services/screenshot_service.py"]
        CONF["config/loader.py"]
        PLOA["policy/loader.py"]
        SCREEN["platform/screen.py"]
        WINSCREEN["platform/windows_screen.py"]
        MOCKSCREEN["platform/mock_screen.py"]
        MOCKEXEC["adapters/mock/action_executor.py"]
    end

    subgraph SERVER_RESOURCES
        BSTATE["services/browser_state.py"]
        BEVENTS["services/browser_events.py"]
        TDTO["transport/dto.py"]
